<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>abb_cell_description</name>
  <version>0.1.0</version>
  <description>ABB IRB 1200 description for the cell, with one ros2_control block that targets mock hardware, Isaac Sim or the real robot.</description>
  <maintainer email="adricampos10@gmail.com">Adrian Campos</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>abb_irb1200_support</exec_depend>
  <exec_depend>abb_resources</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>mock_components</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
